# Copy to .env and fill in. Used by docker-compose.yml; also usable locally.

# Корень исходников конфигурации 1С (XML + BSL)
ONEC_CONFIG_ROOT=/data/config

# Qdrant
ONEC_QDRANT_URL=http://qdrant:6333

ONEC_QDRANT_API_KEY=

ONEC_QDRANT_COLLECTION=onec_config

# SQLite-граф (внутри контейнера)
ONEC_GRAPH_DB_PATH=/data/graph.sqlite3

# Эмбеддер — любой OpenAI-совместимый /embeddings (Ollama: http://host.docker.internal:11434/v1, модель bge-m3)
ONEC_EMBEDDER_BASE_URL=http://host.docker.internal:11434/v1

ONEC_EMBEDDER_API_KEY=

ONEC_EMBEDDER_MODEL=bge-m3

ONEC_EMBEDDER_DIMENSIONS=1024

ONEC_EMBEDDER_BATCH_SIZE=32

# Реранкер — необязательно; пустой endpoint = выключен (возвращается порядок ANN)
ONEC_RERANKER_ENDPOINT=

ONEC_RERANKER_API_KEY=

ONEC_RERANKER_MODEL=

# Поиск / сервер
ONEC_SEARCH_TOP_K=5

ONEC_HOST=0.0.0.0

ONEC_PORT=8765

# Токен-аутентификация (необязательно). Если задан, HTTP-клиент обязан
# присылать заголовок "Authorization: Bearer <token>". Пусто = без аутентификации.
ONEC_AUTH_TOKEN=
